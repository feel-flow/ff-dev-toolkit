{
  "description": "ff-dev-toolkit の更新通知と自動振り返り。SessionStart で新版を通知し、Stop で振り返りを 1 回だけ継続する（fail-open）",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/retrospective-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
