{
  "description": "ff-dev-toolkit の hook 定義。SessionStart（更新通知・自動更新・スキル/レビュアー名簿ドリフト検査）、UserPromptSubmit/Stop（自動振り返り・決定木ルーティングと葉の到達記録）、PreToolUse（Bash 16 ガードの並行集約入口 run-bash-hooks.sh、GitHub MCP 4 ガード、レビュー/全件ゲート走行中の作業ツリー凍結、.sh 保存時検査、工数・指示バイト記録）、PostToolUse（zsh 展開・ff-effort/知見検索通知）、SubagentStart/Stop・PermissionDenied（レビューレーン管理）を登録。各 hook の判定規則・抜け道・無効化（FF_DEV_TOOLKIT_SKIP）の詳細は各 hooks/*.sh のヘッダと README を参照。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-gate-in-flight.sh\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "全件ゲート走行中の作業ツリー変更を確認"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-review-in-flight.sh\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "レビュー中の変更と開始前の差分を確認"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-bash-hooks.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-checkout-restore.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-pr-followup.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-background-cwd.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-long-gate-background.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-effort-actual.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-merge-closing-keyword.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-issue-labels.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-sub-issue-id.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-exit-code.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-zsh-glob.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-literal-write.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-credential-output.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-wsl-shell.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-default-branch-commit.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-issue-collision.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-issue-assign.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/record-effort-wallclock.sh\"",
            "timeout": 30,
            "statusMessage": "Bashコマンドの安全確認と作業時間の記録"
          }
        ]
      },
      {
        "matcher": "^mcp__(github|plugin_github_github)__merge_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-effort-actual.sh\"",
            "timeout": 10,
            "statusMessage": "マージ前にIssueの工数実績を確認"
          }
        ]
      },
      {
        "matcher": "^mcp__(github|plugin_github_github)__issue_write$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-issue-labels.sh\"",
            "timeout": 10,
            "statusMessage": "Issueの必須ラベルを確認"
          }
        ]
      },
      {
        "matcher": "^mcp__(github|plugin_github_github)__(create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-pr-followup.sh\"",
            "timeout": 10,
            "statusMessage": "PRの追跡IssueとDraft指定を確認"
          }
        ]
      },
      {
        "matcher": "^mcp__(github|plugin_github_github)__sub_issue_write$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-sub-issue-id.sh\"",
            "timeout": 10,
            "statusMessage": "子Issue操作のID型を確認"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shell-save.sh\"",
            "timeout": 30,
            "statusMessage": "保存前にシェルスクリプトの不具合を検査"
          }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/record-instruction-bytes.sh\"",
            "timeout": 5,
            "statusMessage": "スキル・仕様書の読み込み量を記録"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-zsh-glob.sh\"",
            "timeout": 10,
            "statusMessage": "zshの未引用変数の注意点を通知"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/warn-missing-ff-effort.sh\"",
            "timeout": 10,
            "statusMessage": "工数ブロックと着手前知見検索・同セッション ACE を通知"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-review-in-flight.sh\"",
            "timeout": 30,
            "statusMessage": "レビュー担当エージェントの開始を記録"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-review-in-flight.sh\"",
            "timeout": 30,
            "statusMessage": "レビュー担当エージェントの終了を反映"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-review-in-flight.sh\"",
            "timeout": 30,
            "statusMessage": "権限拒否時にレビューのロックを整理"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.sh\"",
            "timeout": 10,
            "statusMessage": "ff-dev-toolkitの更新を確認"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-skill-drift.sh\"",
            "timeout": 5,
            "statusMessage": "スキルの欠落・重複インストールを確認"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-review-roster-drift.sh\"",
            "timeout": 5,
            "statusMessage": "レビュー担当の登録と実体を照合"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-update-marketplace.sh\"",
            "async": true,
            "timeout": 120,
            "statusMessage": "マーケットプレイスとプラグインを自動更新"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/retrospective-context.sh\"",
            "timeout": 5,
            "statusMessage": "振り返りの実施手順を事前に案内"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/decision-tree.sh\"",
            "timeout": 5,
            "statusMessage": "変更内容から作業経路を判定・記録"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/retrospective-stop.sh\"",
            "timeout": 5,
            "statusMessage": "作業完了時の振り返り漏れを確認"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/decision-tree.sh\"",
            "timeout": 5,
            "statusMessage": "実行したスキルと作業経路を記録"
          }
        ]
      }
    ]
  }
}
