#!/usr/bin/env bash
args=" $* "
if [[ "${FAKE_CLAIM_GIT_FAIL_ORIGIN_CONFIG:-0}" == 1 && "$args" == *" config --get remote.origin.url "* ]]; then
  echo "simulated origin config failure" >&2
  exit 9
fi
if [[ "${FAKE_CLAIM_GIT_FAIL_INDEX_LOOKUP:-0}" == 1 && "$args" == *" ls-files --stage "* ]]; then
  echo "simulated index lookup failure" >&2
  exit 9
fi
if [[ "${FAKE_CLAIM_GIT_FAIL_CONTRACT_TREE:-0}" == 1 && "$args" == *" ls-tree "* && "$args" == *" .version-claims "* ]]; then
  echo "simulated contract tree failure" >&2
  exit 9
fi
if [[ "${FAKE_CLAIM_GIT_MUTATE_INDEX:-0}" == 1 && "$args" == *" diff --cached "* && "$args" == *" --name-only "* && ! -e "${FAKE_CLAIM_GIT_MARKER:?}" ]]; then
  : > "$FAKE_CLAIM_GIT_MARKER"
  "${FAKE_CLAIM_REAL_GIT:?}" -C "${FAKE_CLAIM_GIT_ROOT:?}" update-index --cacheinfo "100644,${FAKE_CLAIM_GIT_BLOB:?},${FAKE_CLAIM_GIT_PATH:?}"
fi
if [[ "${FAKE_CLAIM_GIT_MOVE_BASE:-0}" == 1 && "$args" == *" diff --cached "* && "$args" == *" --name-only "* && ! -e "${FAKE_CLAIM_GIT_BASE_MARKER:?}" ]]; then
  : > "$FAKE_CLAIM_GIT_BASE_MARKER"
  "${FAKE_CLAIM_REAL_GIT:?}" -C "${FAKE_CLAIM_GIT_ROOT:?}" update-ref refs/remotes/origin/develop "${FAKE_CLAIM_GIT_NEW_BASE:?}"
fi
# fetch だけを、資格情報付き URL を stderr へ出して失敗させる（伏せ字の検査用。実 git は版・
# 経路によって userinfo を自分で落とすため、伏せ字そのものは stub でしか測れない）。
if [[ "${FAKE_CLAIM_GIT_FAIL_FETCH:-0}" == 1 && "$args" == *" fetch origin "* ]]; then
  printf "fatal: unable to access '%s': Failed to connect\n" "${FAKE_CLAIM_GIT_FETCH_URL:?}" >&2
  exit 128
fi
exec "${FAKE_CLAIM_REAL_GIT:?}" "$@"
