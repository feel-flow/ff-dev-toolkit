#!/usr/bin/env bash
if [[ "${FAKE_PERL_UNICODE_FAIL:-0}" == 1 && " $* " == *" -MEncode=decode,FB_CROAK "* ]]; then
  echo "simulated Unicode checker failure" >&2
  exit 9
fi
last="${!#}"
canonical_cwd="$(pwd -P)"
if [[ "${FAKE_PERL_FAIL_RETAINED:-${FAKE_LN_FAIL_RETAINED:-0}}" == 1 && "$canonical_cwd" == */.ff-changelog.lock/.retained ]]; then
  echo "retained hard link failure" >&2
  exit 9
fi
if [[ "${FAKE_PERL_FAIL_RECOVERY:-${FAKE_LN_FAIL_RECOVERY:-0}}" == 1 && "$canonical_cwd" == */.ff-changelog.lock/.recovery ]]; then
  echo "recovery hard link failure" >&2
  exit 9
fi
if [[ "${FAKE_PERL_INPUT_DIRECTORY_RACE:-0}" == 1 && ( "${last##*/}" == .ff-changelog-input.* || "${last##*/}" == .ff-changelog-footer-input.* ) ]]; then
  /bin/mkdir "$last"
fi
if [[ "${FAKE_PERL_RETAINED_DIRECTORY_RACE:-0}" == 1 && "$canonical_cwd" == */.ff-changelog.lock/.retained ]]; then
  /bin/mkdir "$last"
fi
if [[ "${FAKE_PERL_RECOVERY_DIRECTORY_RACE:-0}" == 1 && "$canonical_cwd" == */.ff-changelog.lock/.recovery ]]; then
  /bin/mkdir "$last"
fi
if [[ "${FAKE_PERL_RETAINED_SIGNAL:-0}" == 1 && "$canonical_cwd" == */.ff-changelog.lock/.retained ]]; then
  /usr/bin/perl "$@"
  parent="$(ps -o ppid= -p "$PPID" | tr -d ' ')"
  kill -TERM "$parent"
  exit 0
fi
if [[ "${last##*/}" == CHANGELOG.md ]]; then
  [[ "${FAKE_LN_FAIL_CHANGELOG:-0}" != 1 ]] || { echo "read-only destination" >&2; exit 9; }
  [[ "${FAKE_LINK_DIRECTORY_RACE:-0}" != 1 ]] || /bin/mkdir "$last"
  [[ "${FAKE_LN_DANGLING_RACE:-0}" != 1 ]] || /bin/ln -s missing-external-target "$last"
  [[ "${FAKE_LN_ATOMIC_RACE:-0}" != 1 ]] || printf '%s\n' 'external atomic replacement' > "$last"
  if [[ "${FAKE_LN_MUTATE_OLD:-0}" == 1 ]]; then
    shopt -s nullglob
    old=("${FAKE_LN_OLD_DIR:?}"/.ff-changelog-old.*)
    printf '%s\n' 'external old inode edit' >> "${old[0]:?}"
  fi
  if [[ "${FAKE_LN_INSTALL_SIGNAL:-0}" == 1 ]]; then
    /usr/bin/perl "$@"
    parent="$(ps -o ppid= -p "$PPID" | tr -d ' ')"
    kill -TERM "$parent"
    exit 0
  fi
fi
exec /usr/bin/perl "$@"
