#!/usr/bin/env bash
last="${*: -1}"
if [[ "${FAKE_RM_MUTATE_FOOTER_OLD:-0}" == 1 && "$last" == */.ff-changelog-footer-old.* && -s "$last" ]]; then
  printf '%s\n' 'external footer old inode edit' >> "$last"
fi
if [[ "${FAKE_RM_MUTATE_FINAL_OLD:-0}" == 1 && "$last" == */.ff-changelog-old.* && -s "$last" ]]; then
  printf '%s\n' 'external final old inode edit' >> "$last"
fi
if [[ "${FAKE_RM_REPLACE_FINAL_CURRENT:-0}" == 1 && "$last" == */.ff-changelog.lock/.retained/*.md && ! -e "${FAKE_RM_FINAL_MARKER:?}" ]]; then
  : > "$FAKE_RM_FINAL_MARKER"
  race_tmp="${FAKE_RM_FINAL_CHANGELOG:?}.final-race"
  printf '%s\n' 'external final replacement' > "$race_tmp"
  /bin/mv "$race_tmp" "$FAKE_RM_FINAL_CHANGELOG"
fi
if [[ "${FAKE_RM_SIGNAL_RETAINED:-0}" == 1 && "$last" == */.ff-changelog.lock/.retained/*.md && ! -e "${FAKE_RM_SIGNAL_MARKER:?}" ]]; then
  : > "$FAKE_RM_SIGNAL_MARKER"
  /bin/rm "$@" || exit $?
  kill -TERM "$PPID"
  exit 0
fi
if [[ "${FAKE_RM_REPLACE_FOOTER_CURRENT:-0}" == 1 && "$last" == */.ff-changelog-footer-old.* && -s "$last" ]]; then
  race_tmp="${FAKE_RM_FOOTER_CHANGELOG:?}.final-race"
  printf '%s\n' 'external footer final replacement' > "$race_tmp"
  /bin/mv "$race_tmp" "$FAKE_RM_FOOTER_CHANGELOG"
fi
if [[ "${FAKE_RM_CHANGELOG_RACE:-0}" == 1 && "$last" == */.ff-changelog.lock/.consumed/*.md && ! -e "${FAKE_RM_RACE_MARKER:?}" ]]; then
  : > "$FAKE_RM_RACE_MARKER"
  race_tmp="${FAKE_RM_CHANGELOG:?}.external-race"
  printf '%s\n' 'external post-consume replacement' > "$race_tmp"
  /bin/mv "$race_tmp" "$FAKE_RM_CHANGELOG"
fi
if [[ "${FAKE_RM_MUTATE_OLD:-0}" == 1 && "$last" == */.ff-changelog.lock/.consumed/*.md && ! -e "${FAKE_RM_OLD_MARKER:?}" ]]; then
  : > "$FAKE_RM_OLD_MARKER"
  shopt -s nullglob
  old=("${FAKE_RM_OLD_DIR:?}"/.ff-changelog-old.*)
  printf '%s\n' 'external late old inode edit' >> "${old[0]:?}"
fi
if [[ "${FAKE_RM_RECOVERY_RACE:-0}" == 1 && "$last" == */.ff-changelog.lock/.recovery/*.md && ! -e "${FAKE_RM_RECOVERY_RACE_MARKER:?}" ]]; then
  : > "$FAKE_RM_RECOVERY_RACE_MARKER"
  race_tmp="${FAKE_RM_RECOVERY_CHANGELOG:?}.external-race"
  printf '%s\n' 'external recovery replacement' > "$race_tmp"
  /bin/mv "$race_tmp" "$FAKE_RM_RECOVERY_CHANGELOG"
fi
if [[ -n "${FAKE_RM_FAIL_ON_CONSUMED:-}" && "$last" == */.ff-changelog.lock/.consumed/*.md ]]; then
  count=0
  [[ ! -f "${FAKE_RM_COUNT_FILE:?}" ]] || count="$(cat "$FAKE_RM_COUNT_FILE")"
  count=$((count + 1))
  printf '%s\n' "$count" > "$FAKE_RM_COUNT_FILE"
  if [[ "$count" -eq "$FAKE_RM_FAIL_ON_CONSUMED" ]]; then
    echo "consumed delete failure" >&2
    exit 9
  fi
fi
if [[ -n "${FAKE_RM_FAIL_ON_RECOVERY:-}" && "$last" == */.ff-changelog.lock/.recovery/*.md ]]; then
  count=0
  [[ ! -f "${FAKE_RM_RECOVERY_COUNT_FILE:?}" ]] || count="$(cat "$FAKE_RM_RECOVERY_COUNT_FILE")"
  count=$((count + 1))
  printf '%s\n' "$count" > "$FAKE_RM_RECOVERY_COUNT_FILE"
  if [[ "$count" -eq "$FAKE_RM_FAIL_ON_RECOVERY" ]]; then
    echo "recovery delete failure" >&2
    exit 9
  fi
fi
exec /bin/rm "$@"
