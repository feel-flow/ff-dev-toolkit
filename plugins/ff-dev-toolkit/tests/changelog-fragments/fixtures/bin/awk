#!/usr/bin/env bash
if [[ "${FAKE_AWK_BLOCK_READ_FAIL:-0}" == 1 ]]; then
  for arg in "$@"; do
    case "$arg" in
      block=*) block_path="${arg#block=}"; /bin/rm -f -- "$block_path"; /bin/mkdir "$block_path"; break ;;
    esac
  done
fi
if [[ "${FAKE_AWK_REPLACE_CHANGELOG:-0}" != 1 ]]; then
  exec "${FAKE_REAL_AWK:-/usr/bin/awk}" "$@"
fi
set +e
out="$("${FAKE_REAL_AWK:-/usr/bin/awk}" "$@")"
rc=$?
set -e
if [[ "${FAKE_AWK_REPLACE_CHANGELOG:-0}" == 1 && "$*" == *"Unreleased"* && ! -e "${FAKE_AWK_REPLACE_MARKER:?}" ]]; then
  : > "$FAKE_AWK_REPLACE_MARKER"
  replacement="${FAKE_AWK_CHANGELOG:?}.replacement"
  /bin/cp "$FAKE_AWK_CHANGELOG" "$replacement"
  /bin/mv "$replacement" "$FAKE_AWK_CHANGELOG"
fi
printf '%s\n' "$out"
exit "$rc"
